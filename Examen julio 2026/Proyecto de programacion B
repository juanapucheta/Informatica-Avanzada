import java.time.LocalDateTime;

public class Reserva {
    protected EspacioBase espacio;
    protected Usuario usuario;
    protected LocalDateTime inicio;
    protected int duracionHoras;

    public Reserva(EspacioBase espacio, Usuario usuario, LocalDateTime inicio, int duracionHoras) {
        this.espacio = espacio;
        this.usuario = usuario;
        this.inicio = inicio;
        this.duracionHoras = duracionHoras;
    }

    public EspacioBase getEspacio() { return espacio; }
    public Usuario getUsuario() { return usuario; }
    public LocalDateTime getInicio() { return inicio; }
    public int getDuracionHoras() { return duracionHoras; }
    
    /**
     * indica si el horario de esta Reserva se superpone con otro horario y duración
     * pasada como parámetro
     * 
     * Por ejemplo, si esta reserva es de 9 a 11,
     *  otroInicio 10, otrasHoras 1 -> true
     *  otroInicio 8, otrasHoras 2 -> True
     *  otroInicio 8, otrasHoras 1 -> false
     * 
     */
    public boolean seSuperpone(LocalDateTime otroInicio, int otrasHoras) {
      LocalDateTime fin = this.inicio.plusHours(this.duracionHoras);
      LocalDateTime otroFin = otroInicio.plusHours(otrasHoras);
      
      // Si tengo el primer rango [A, B] y otro rango con [C, D], se van a superponer si 
      // sucede que (A < D) y (C < B). Comparo eso entonces. 
      
      return this.inicio.isBefore(otroFin) && otroInicio.isBefore(fin);
    }

    @Override
    /**
     * Retorna un string que represente la Reserva con el formato
     * "Reserva de <nombre_sala> por <usuario> desde <hora_inicio> por <duracion> horas""     * 
     * Ej
     *  Reserva de Uritorco por Juan Perez <jp@mail.com> desde 2025-06-16T10:00 por 1h"
     */
     public String toString() {
       String info = "Reserva de " + this.espacio.getNombre() +
                    " por " + this.usuario.toString() +
                    " desde " + this.inicio.toString() +
                    " por " + this.duracionHoras + "h" ;
       return info;
    }
}

